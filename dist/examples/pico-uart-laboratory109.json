  "code": "#include \"lab.h\"\nvolatile unsigned done,failures,phase,mark_ok,space_ok,parity_error,parity_clear;\nvolatile unsigned break_word,break_extra,break_clear,break_recovery,dht11_ok,dht22_ok;\nvolatile unsigned clock_word,clock_us,gate_busy,gate_empty,gate_word,gate_us,divider_word;\nvolatile unsigned timeout_paused,timeout_resumed;\nvolatile unsigned dht_stage,dht_raw11[5],dht_raw22[5];\nstatic volatile unsigned *peri_ctrl=(volatile unsigned*)(PICO_RP2350?0x40010048u:0x40008048u);\nstatic void drain(void){while(uart_is_readable(uart0))uart_get_hw(uart0)->dr;uart_get_hw(uart0)->rsr=0;}\nstatic unsigned word(unsigned timeout){unsigned t=time_us_32();while(!uart_is_readable(uart0)){if((unsigned)(time_us_32()-t)>=timeout)return 0xffff;sleep_us(10);}return uart_get_hw(uart0)->dr;}\nstatic void source(unsigned s){*peri_ctrl=0;sleep_us(2);*peri_ctrl=s<<5;*peri_ctrl=0x800|(s<<5);sleep_us(2);}\nstatic void low(int p){gpio_put(p,0);gpio_set_dir(p,1);}\nstatic void release(int p){gpio_set_dir(p,0);}\nstatic int wait_level(int p,int v,unsigned limit){unsigned t=time_us_32();while(gpio_get(p)!=v){if((unsigned)(time_us_32()-t)>limit)return -1;}return time_us_32()-t;}\nstatic int dht(int p,int start,int temperature,int humidity){\n uint8_t b[5]={0};low(p);sleep_ms(start);release(p);\n if(wait_level(p,0,200)<0){dht_stage=1;return 0;}if(wait_level(p,1,200)<0){dht_stage=2;return 0;}if(wait_level(p,0,200)<0){dht_stage=3;return 0;}\n for(int i=0;i<40;i++){if(wait_level(p,1,150)<0){dht_stage=100+i;return 0;}unsigned t=time_us_32();if(wait_level(p,0,150)<0){dht_stage=200+i;return 0;}b[i/8]=(b[i/8]<<1)|((unsigned)(time_us_32()-t)>45);}\n for(int i=0;i<5;i++){if(p==10)dht_raw11[i]=b[i];else dht_raw22[i]=b[i];}\n if((uint8_t)(b[0]+b[1]+b[2]+b[3])!=b[4])return 0;\n return p==10?b[0]==humidity&&b[2]==temperature:(b[0]*256+b[1])==humidity*10&&(b[2]*256+b[3])==temperature*10;\n}\nint main(void){\n stdio_init_all();gpio_set_function(0,GPIO_FUNC_UART);gpio_set_function(1,GPIO_FUNC_SIO);uart_init(uart0,9600);\n gpio_set_function(8,GPIO_FUNC_UART);gpio_set_function(9,GPIO_FUNC_UART);gpio_set_function(17,GPIO_FUNC_UART);uart_init(uart1,9600);\n // Added GP8 -> GP17 wire: TX1 reaches RX0 electrically; sensor wires stay in place.\n uart_get_hw(uart0)->lcr_h=0xf2;uart_get_hw(uart1)->lcr_h=0xf2;\n for(unsigned i=0;i<4;i++){unsigned b=i==0?0:i==1?1:i==2?255:85;uart_putc_raw(uart1,b);mark_ok+=word(20000)==b;}\n uart_tx_wait_blocking(uart1);uart_get_hw(uart0)->lcr_h=0xf6;uart_get_hw(uart1)->lcr_h=0xf6;\n for(unsigned i=0;i<4;i++){unsigned b=i==0?0:i==1?1:i==2?255:85;uart_putc_raw(uart1,b);space_ok+=word(20000)==b;}\n uart_tx_wait_blocking(uart1);uart_get_hw(uart1)->lcr_h=0xf2;uart_putc_raw(uart1,0x55);parity_error=word(20000);uart_get_hw(uart0)->rsr=0;parity_clear=uart_get_hw(uart0)->rsr;\n uart_tx_wait_blocking(uart1);uart_get_hw(uart0)->lcr_h=0x70;uart_get_hw(uart1)->lcr_h=0x70;drain();\n // DHT modules require their power-up settling interval before a request.\n sleep_ms(1100);\n // Hold a real break during both DHT transactions: one BE zero, no repeated bytes.\n gpio_init(10);gpio_pull_up(10);gpio_init(11);gpio_pull_up(11);\n uart_get_hw(uart1)->lcr_h=0x71;phase=1;\n dht11_ok=dht(10,20,26,61);dht22_ok=dht(11,2,27,62);\n break_word=word(20000);sleep_ms(3);break_extra=uart_is_readable(uart0);\n uart_get_hw(uart1)->lcr_h=0x70;sleep_ms(2);uart_get_hw(uart0)->rsr=0;break_clear=uart_get_hw(uart0)->rsr;\n uart_putc_raw(uart1,0xa5);break_recovery=word(20000);uart_tx_wait_blocking(uart1);\n // Safe clock-source change during a frame; TX and RX keep their bit phase.\n drain();unsigned t=time_us_32();uart_putc_raw(uart1,0x55);sleep_us(250);source(2);\n clock_word=word(20000);uart_tx_wait_blocking(uart1);clock_us=time_us_32()-t;\n source(0);drain();\n t=time_us_32();uart_putc_raw(uart1,0x96);sleep_us(250);*peri_ctrl=0;sleep_us(2);phase=2;sleep_ms(3);\n gate_busy=uart_get_hw(uart1)->fr&8;gate_empty=!uart_is_readable(uart0);*peri_ctrl=0x800;sleep_us(2);\n gate_word=word(20000);uart_tx_wait_blocking(uart1);gate_us=time_us_32()-t;\n if(PICO_RP2350){drain();volatile unsigned *div=peri_ctrl+1;uart_putc_raw(uart1,0x69);sleep_us(250);*div=2u<<16;divider_word=word(20000);uart_tx_wait_blocking(uart1);*div=1u<<16;sleep_us(2);}else divider_word=0x69;\n // A receive timeout counts UART clock bits, not wall time while clock-gated.\n drain();uart_putc_raw(uart1,0x6c);sleep_ms(2);uart_get_hw(uart0)->icr=64;*peri_ctrl=0;sleep_us(2);sleep_ms(5);\n timeout_paused=uart_get_hw(uart0)->ris&64;*peri_ctrl=0x800;sleep_ms(4);timeout_resumed=uart_get_hw(uart0)->ris&64;drain();\n failures=mark_ok!=4||space_ok!=4||!(parity_error&512)||parity_clear;\n failures+=!(break_word&1024)||break_extra||break_clear||break_recovery!=0xa5||!dht11_ok||!dht22_ok;\n failures+=clock_word!=0x55||clock_us<1500||!gate_busy||!gate_empty||gate_word!=0x96||gate_us<4000||divider_word!=0x69||timeout_paused||!timeout_resumed;\n // Restore normal sensor UARTs, with both DHT modules still physically wired.\n gpio_set_function(17,GPIO_FUNC_SIO);gpio_set_dir(17,GPIO_IN);gpio_pull_up(17);gpio_set_function(1,GPIO_FUNC_UART);\n uart_init(uart0,9600);uart_init(uart1,9600);gps_window(1200000);uart_tx_wait_blocking(uart0);int co2=co2_read();\n failures+=!(gps_rmc&&gps_gga&&!gps_bad&&reply_crc&&co2==850);\n printf(\"DHT stage=%u 11=%u,%u,%u,%u,%u 22=%u,%u,%u,%u,%u\\n\",dht_stage,dht_raw11[0],dht_raw11[1],dht_raw11[2],dht_raw11[3],dht_raw11[4],dht_raw22[0],dht_raw22[1],dht_raw22[2],dht_raw22[3],dht_raw22[4]);\n printf(\"PARITY mark=%u space=%u mismatch=%u clear=%u\\n\",mark_ok,space_ok,parity_error,parity_clear);\n printf(\"BREAK word=%u extra=%u clear=%u recovery=%u DHT11=%u DHT22=%u\\n\",break_word,break_extra,break_clear,break_recovery,dht11_ok,dht22_ok);\n printf(\"CLOCK word=%u us=%u gate=%u/%u word=%u us=%u divider=%u timeout=%u/%u\\n\",clock_word,clock_us,gate_busy,gate_empty,gate_word,gate_us,divider_word,timeout_paused,timeout_resumed);\n printf(\"GPS valid=%u bad=%u MHZ19 ppm=%d crc=%u\\n\",gps_valid,gps_bad,co2,reply_crc);\n printf(\"UART109 COMPLETE failures=%u\\n\",failures);done=1;\n while(1)sleep_ms(100);\n}\n",
