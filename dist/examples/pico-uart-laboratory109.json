  "language": "c",
  "files": [
    {
      "name": "lab.h",
      "content": "#pragma once\n#include <pico/stdlib.h>\n#include <hardware/uart.h>\n#include <hardware/i2c.h>\n#include <stdio.h>\nextern volatile unsigned gps_valid,gps_bad,gps_rmc,gps_gga,done,round_no,reply_count,reply_crc;\nvoid gps_poll(void);void gps_window(unsigned);int co2_read(void);\n"
    },
    {
      "name": "nmea.c",
      "content": "#include \"lab.h\"\nvolatile unsigned gps_valid,gps_bad,gps_rmc,gps_gga;\nstatic char line[100];static unsigned used;static char messages[2][100];static unsigned saved;\nstatic unsigned hex(char c){return c>='0'&&c<='9'?c-'0':c>='A'&&c<='F'?c-'A'+10:255;}\nvoid gps_poll(void){while(uart_is_readable(uart0)){char c=uart_getc(uart0);if(c=='$'){used=0;line[used++]=c;continue;}if(!used)continue;if(c=='\\n'){line[used]=0;unsigned crc=0,i=1;while(i<used&&line[i]!='*')crc^=line[i++];if(i+2<used&&crc==(hex(line[i+1])*16+hex(line[i+2]))){gps_valid++;if(saved<2){unsigned k=0;do{messages[saved][k]=line[k];}while(line[k++]);saved++;}if(line[3]=='R'&&line[4]=='M'&&line[5]=='C')gps_rmc++;if(line[3]=='G'&&line[4]=='G'&&line[5]=='A')gps_gga++;}else gps_bad++;used=0;}else if(used<98)line[used++]=c;else used=0;}}\nvoid gps_window(unsigned us){unsigned at=time_us_32();while((unsigned)(time_us_32()-at)<us){gps_poll();sleep_us(100);}for(unsigned k=0;k<saved;k++)printf(\"NMEA %s\\n\",messages[k]);saved=0;}\n"
    },
    {
      "name": "co2.c",
      "content": "#include \"lab.h\"\nvolatile unsigned reply_count,reply_crc;volatile int ppm;\nint co2_read(void){\n uart_set_baudrate(uart1,9600);uart_set_format(uart1,8,1,UART_PARITY_NONE);\n gpio_set_function(8,GPIO_FUNC_UART);gpio_set_function(9,GPIO_FUNC_UART);uart_get_hw(uart1)->cr=0x301u;\n while(uart_is_readable(uart1))uart_getc(uart1);\n uint8_t query[]={255,1,0x86,0,0,0,0,0,0x79},reply[9]={0};reply_count=0;reply_crc=0;ppm=-1;\n uart_write_blocking(uart1,query,9);unsigned at=time_us_32();while(reply_count<9&&(unsigned)(time_us_32()-at)<120000){gps_poll();if(uart_is_readable(uart1))reply[reply_count++]=uart_getc(uart1);else sleep_us(50);}\n if(reply_count==9){unsigned sum=0;for(int i=1;i<8;i++)sum+=reply[i];reply_crc=((256-sum)&255)==reply[8]&&reply[0]==255&&reply[1]==0x86;if(reply_crc)ppm=reply[2]*256+reply[3];}\n return ppm;\n}\n"
    }
  ]
