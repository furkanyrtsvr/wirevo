  "code": "#include <pico/stdlib.h>\n#include <stdio.h>\nvolatile unsigned done;volatile unsigned word,ir_low,ir_idle,ir_released;\nint main(void){stdio_init_all();gpio_init(16);gpio_init(15);for(int p=18;p<=19;p++){gpio_init(p);gpio_set_dir(p,1);gpio_put(p,0);}gpio_put(19,1);sleep_us(10);gpio_put(19,0);for(int b=0;b<32;b++){gpio_put(18,0);sleep_us(5);gpio_put(18,1);sleep_us(5);if(b>=1&&b<=24)word=(word<<1)|gpio_get(16);}printf(\"I2S sample=%u\\n\",word);gpio_init(14);gpio_set_dir(14,1);ir_idle=gpio_get(15);for(int i=0;i<32;i++){gpio_put(14,1);sleep_us(12);gpio_put(14,0);sleep_us(12);if(!gpio_get(15))ir_low++;}sleep_ms(1);ir_released=gpio_get(15);printf(\"IR idle=%u activeSamples=%u released=%u\\n\",ir_idle,ir_low,ir_released);puts(\"LAB DONE\");done=1;while(1)sleep_ms(100);}\r\n",
