    {
      "name": "lab_i2c.c",
      "content": "#include <pico/stdlib.h>\n#include <hardware/i2c.h>\n#include <stdio.h>\nstatic volatile unsigned checks,failures,done;\nstatic int readreg(i2c_inst_t*b,int a,int reg,int n){uint8_t r=reg,v[32]={0};int w=i2c_write_timeout_us(b,a,&r,1,true,20000),q=i2c_read_timeout_us(b,a,v,n,false,20000);printf(\"READ bus=%u address=%u reg=%u n=%d w=%d r=%d data=\",b->index,a,reg,n,w,q);for(int j=0;j<n;j++)printf(\"%u\",v[j]);puts(\"\");checks++;if(w!=1||q!=n)failures++;return v[0];}\nstatic void wr(i2c_inst_t*b,int a,int reg,int value){uint8_t d[]={reg,value};if(i2c_write_timeout_us(b,a,d,2,false,20000)!=2)failures++;}\nint lab_i2c(void){stdio_init_all();for(int p=4;p<8;p++){gpio_set_function(p,GPIO_FUNC_I2C);gpio_pull_up(p);}i2c_init(i2c0,100000);i2c_init(i2c1,100000);puts(\"LAB I2C START\");\nuint8_t sht[]={0x24,0},ahtInit[]={0xbe,8,0},ahtMeasure[]={0xac,0x33,0};i2c_write_blocking(i2c0,0x44,sht,2,false);i2c_write_blocking(i2c0,0x38,ahtInit,3,false);i2c_write_blocking(i2c0,0x38,ahtMeasure,3,false);\nwr(i2c0,0x53,0x2d,8);wr(i2c0,0x76,0xf2,1);wr(i2c0,0x76,0xf4,0x25);wr(i2c0,0x77,0x72,1);wr(i2c0,0x77,0x74,0x25);wr(i2c0,0x29,0,1);wr(i2c1,0x29,0x80,3);wr(i2c0,0x57,9,3);wr(i2c0,0x57,10,0x27);wr(i2c0,0x69,0x6b,0);wr(i2c1,0x76,0xf4,0x25);uint8_t bh=0x10;i2c_write_blocking(i2c0,0x23,&bh,1,false);uint8_t ads[]={1,0xc3,0x83};i2c_write_blocking(i2c0,0x48,ads,3,false);sleep_ms(190);\nuint8_t v[8];int n=i2c_read_blocking(i2c0,0x44,v,6,false);printf(\"SHT31 n=%d raw=%u%u%u%u%u%u\\n\",n,v[0],v[1],v[2],v[3],v[4],v[5]);checks++;if(n!=6)failures++;n=i2c_read_blocking(i2c0,0x38,v,7,false);printf(\"AHT20 n=%d status=%u\\n\",n,v[0]);checks++;if(n!=7||(v[0]&128))failures++;\nif(readreg(i2c0,0x53,0,1)!=0xe5)failures++;readreg(i2c0,0x53,0x32,6);readreg(i2c0,0x48,0,2);\nif(readreg(i2c0,0x76,0xd0,1)!=0x60)failures++;readreg(i2c0,0x76,0xf7,8);if(readreg(i2c0,0x77,0xd0,1)!=0x61)failures++;readreg(i2c0,0x77,0x1d,15);\nreadreg(i2c0,0x29,0xc0,1);readreg(i2c0,0x29,0x14,12);readreg(i2c0,0x40,0xfe,2);readreg(i2c0,0x40,2,2);readreg(i2c0,0x41,2,2);if(readreg(i2c0,0x57,0xff,1)!=0x15)failures++;readreg(i2c0,0x57,7,6);n=i2c_read_blocking(i2c0,0x23,v,2,false);printf(\"BH1750 n=%d raw=%u%u\\n\",n,v[0],v[1]);checks++;if(n!=2)failures++;\nif(readreg(i2c0,0x69,0x75,1)!=0x68)failures++;readreg(i2c0,0x69,0x3b,14);readreg(i2c0,0x68,0x11,2);readreg(i2c0,0x68,0,7);if(readreg(i2c1,0x29,0x92,1)!=0x44)failures++;readreg(i2c1,0x29,0xb4,8);if(readreg(i2c1,0x76,0xd0,1)!=0x58)failures++;readreg(i2c1,0x76,0xf7,6);readreg(i2c1,0x68,0,7);\nprintf(\"LAB DONE checks=%u failures=%u\\n\",checks,failures);return failures;\n}\n"
    },
    {
      "name": "lab_timed.c",
      "content": "#include <pico/stdlib.h>\n#include <hardware/spi.h>\n#include <hardware/uart.h>\n#include <stdio.h>\nstatic volatile unsigned done,failures;volatile int dht11ok,dht22ok,presence,temperature16,loadcode,distance_us,thermocode,bmpid,co2ppm,gps_chars;\nstatic void low(int p){gpio_put(p,0);gpio_set_dir(p,1);}static void release(int p){gpio_set_dir(p,0);}static int waitlevel(int p,int level,unsigned timeout){unsigned t=time_us_32();while(gpio_get(p)!=level){if((unsigned)(time_us_32()-t)>timeout)return -1;}return (unsigned)(time_us_32()-t);}\nstatic int dht(int p,int start){uint8_t b[5]={0};low(p);sleep_ms(start);release(p);if(waitlevel(p,0,200)<0||waitlevel(p,1,200)<0||waitlevel(p,0,200)<0)return -1;for(int j=0;j<40;j++){if(waitlevel(p,1,150)<0)return -2;unsigned t=time_us_32();if(waitlevel(p,0,150)<0)return -3;b[j/8]=(b[j/8]<<1)|((unsigned)(time_us_32()-t)>45);}printf(\"DHT pin=%d bytes=%u,%u,%u,%u,%u\\n\",p,b[0],b[1],b[2],b[3],b[4]);return (uint8_t)(b[0]+b[1]+b[2]+b[3])==b[4]?1:-4;}\nstatic int resetow(void){low(12);sleep_us(500);release(12);sleep_us(70);int present=!gpio_get(12);sleep_us(420);return present;}\nstatic void owbyte(unsigned b){for(int i=0;i<8;i++){low(12);sleep_us(b&1?6:60);release(12);sleep_us(b&1?64:10);b>>=1;}}\nstatic unsigned owread(void){unsigned b=0;for(int i=0;i<8;i++){low(12);sleep_us(3);release(12);sleep_us(9);b|=gpio_get(12)<<i;sleep_us(55);}return b;}\nint lab_timed(void){stdio_init_all();for(int p=10;p<=13;p++){gpio_init(p);gpio_pull_up(p);}for(int p=14;p<=15;p++){gpio_init(p);gpio_set_dir(p,1);}gpio_init(21);for(int p=16;p<=19;p++)gpio_set_function(p,GPIO_FUNC_SPI);gpio_init(17);gpio_set_dir(17,1);gpio_put(17,1);gpio_init(20);gpio_set_dir(20,1);gpio_put(20,1);spi_init(spi0,100000);gpio_set_function(8,GPIO_FUNC_UART);gpio_set_function(9,GPIO_FUNC_UART);uart_init(uart1,9600);gpio_set_function(0,GPIO_FUNC_UART);gpio_set_function(1,GPIO_FUNC_UART);uart_init(uart0,9600);puts(\"LAB TIMED START\");\nunsigned t=time_us_32();while((unsigned)(time_us_32()-t)<1200000){if(uart_is_readable(uart0)){int c=uart_getc(uart0);if(c=='$'||gps_chars)gps_chars++;}sleep_us(100);}printf(\"GPS chars=%d\\n\",gps_chars);\ndht11ok=dht(10,20);dht22ok=dht(11,2);printf(\"DHT results=%d,%d\\n\",dht11ok,dht22ok);if(dht11ok!=1||dht22ok!=1)failures++;\npresence=resetow();owbyte(0xcc);owbyte(0x44);sleep_ms(760);resetow();owbyte(0xcc);owbyte(0xbe);unsigned lo=owread(),hi=owread();temperature16=(int16_t)(lo|(hi<<8));printf(\"ONEWIRE presence=%d T16=%d\\n\",presence,temperature16);if(!presence||temperature16!=448)failures++;\nif(waitlevel(13,0,100000)<0)failures++;unsigned code=0;for(int i=0;i<24;i++){gpio_put(14,1);sleep_us(2);code=(code<<1)|gpio_get(13);gpio_put(14,0);sleep_us(2);}gpio_put(14,1);sleep_us(2);gpio_put(14,0);loadcode=(int32_t)(code<<8)>>8;printf(\"HX711 code=%d\\n\",loadcode);\ngpio_put(15,1);sleep_us(12);gpio_put(15,0);if(waitlevel(21,1,20000)<0){failures++;distance_us=-1;}else{unsigned rise=time_us_32();if(waitlevel(21,0,20000)<0){failures++;distance_us=-2;}else distance_us=time_us_32()-rise;}printf(\"ULTRASONIC us=%d\\n\",distance_us);\nuint8_t tx[]={0xd0,0},rx[2];gpio_put(17,0);spi_write_read_blocking(spi0,tx,rx,2);gpio_put(17,1);bmpid=rx[1];printf(\"SPI BMP id=%d\\n\",bmpid);if(bmpid!=0x58)failures++;\nspi_set_format(spi0,16,0,0,SPI_MSB_FIRST);uint16_t thermo;gpio_put(20,0);spi_read16_blocking(spi0,0,&thermo,1);gpio_put(20,1);thermocode=thermo>>3;printf(\"SPI MAX6675 T4=%d open=%d\\n\",thermocode,!!(thermo&4));if(thermocode!=500||(thermo&4))failures++;\nuint8_t query[]={255,1,0x86,0,0,0,0,0,0x79},reply[9]={0};uart_write_blocking(uart1,query,9);t=time_us_32();int count=0;while(count<9&&(unsigned)(time_us_32()-t)<200000){if(uart_is_readable(uart1))reply[count++]=uart_getc(uart1);else sleep_us(20);}co2ppm=reply[2]*256+reply[3];printf(\"UART MHZ19 n=%d ppm=%d\\n\",count,co2ppm);if(count!=9||co2ppm!=850)failures++;if(gps_chars<20)failures++;printf(\"LAB DONE failures=%u\\n\",failures);return failures;}\r\n"
    },
    {
      "name": "lab_analog.c",
      "content": "#include <pico/stdlib.h>\n#include <hardware/adc.h>\n#include <stdio.h>\nstatic unsigned pins[]={2,3,22,26};static void channel(unsigned n){for(int i=0;i<4;i++)gpio_put(pins[i],!!(n&(1<<i)));sleep_us(50);}\nint lab_analog(void){adc_init();adc_gpio_init(28);adc_gpio_init(27);for(int i=0;i<4;i++){gpio_init(pins[i]);gpio_set_dir(pins[i],1);}adc_select_input(2);for(int c=0;c<15;c++){channel(c);printf(\"MUX channel=%u ADC=%u\\n\",c,adc_read());}adc_select_input(1);printf(\"PIR ADC=%u\\n\",adc_read());channel(15);gpio_init(28);for(int p=18;p<=19;p++){gpio_init(p);gpio_set_dir(p,1);gpio_put(p,0);}gpio_put(19,1);sleep_us(10);gpio_put(19,0);unsigned word=0;for(int i=0;i<32;i++){gpio_put(18,0);sleep_us(5);gpio_put(18,1);sleep_us(5);if(i>=1&&i<=24)word=(word<<1)|gpio_get(28);}printf(\"I2S sample=%u\\n\",word);return word!=1048576;}\r\n"
    }
