  "code": "#include \"cf_board_config.h\"\n#include <stdio.h>\n#define R(a) (*(volatile unsigned*)(a))\n// PB0/PB1 reach PA0/PA1 through equal net labels. No direct CNT fabrication.\nstatic void turn(unsigned reverse){\n if(!reverse){cf_gpio_write(PB0,1);cf_gpio_write(PB1,1);cf_gpio_write(PB0,0);cf_gpio_write(PB1,0);}\n else{cf_gpio_write(PB1,1);cf_gpio_write(PB0,1);cf_gpio_write(PB1,0);cf_gpio_write(PB0,0);}\n}\nint main(void){\n puts(\"ENCODER READY: F=forward +4, B=back -4 (65535 wrap)\");\n for(;;){int ch=cf_uart_read();if(ch=='F'||ch=='B'){turn(ch=='B');printf(\"COUNT=%u DIR=%s\\n\",cf_tim2_encoder_count(),R(0x40000000)&16?\"DOWN\":\"UP\");}}\n}\n",
