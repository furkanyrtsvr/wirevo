      "content": "// CircuitForge pin configuration v1\n#include \"cf_board_config.h\"\n\n/* Runs after clocks/data/bss, before main. main may reconfigure GPIO. */\nvoid cf_board_init(void){\n    cf_gpio_mode(PB0,CF_OUTPUT);\n    cf_gpio_write(PB0,0);\n    cf_gpio_mode(PB1,CF_OUTPUT);\n    cf_gpio_write(PB1,0);\n    cf_tim2_encoder_begin(3,65535u,0,0);\n    cf_uart_begin(115200);\n}\n"
