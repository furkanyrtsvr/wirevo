      "code": "#include <SPI.h>\nvoid writeReg(uint8_t a,uint8_t v){digitalWrite(10,LOW);SPI.transfer(0x40);SPI.transfer(a);SPI.transfer(v);digitalWrite(10,HIGH);}\nuint8_t readReg(uint8_t a){digitalWrite(10,LOW);SPI.transfer(0x41);SPI.transfer(a);uint8_t v=SPI.transfer(0);digitalWrite(10,HIGH);return v;}\nvoid setup(){Serial.begin(115200);pinMode(10,OUTPUT);digitalWrite(10,HIGH);pinMode(2,INPUT);SPI.begin();SPI.beginTransaction(SPISettings(1000000,MSBFIRST,SPI_MODE0));writeReg(0,0xfe);writeReg(0x0d,0x80);writeReg(0x05,0x80);}\nvoid loop(){static uint8_t high=0;writeReg(0x14,(high^=1));uint8_t irq=digitalRead(2),flags=readReg(0x0f),gpio=readReg(0x13);Serial.print(\"SPI GPIO B=\");Serial.print(gpio);Serial.print(\" IRQ=\");Serial.print(irq);Serial.print(\" FLAGS=\");Serial.print(flags);Serial.print(\" ADC=\");Serial.println(analogRead(A0));delay(200);}\n",
