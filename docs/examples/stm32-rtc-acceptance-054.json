  "code": "#include <cf_hal.h>\n#include <stdio.h>\n#define R(a) (*(volatile unsigned*)(a))\nvolatile unsigned short samples[2];\nvolatile unsigned button_count;\nvoid EXTI15_10_IRQHandler(void){\n if(cf_exti_pending(PC13)){cf_exti_clear(PC13);button_count++;cf_gpio_write(PA5,button_count&1);}\n}\nint main(void){\n cf_uart_begin(115200);\n unsigned boots=0;cf_backup_read(0,&boots);\n if(!boots){const unsigned initial[7]={2024,2,28,3,23,59,58};cf_rtc_set_calendar(initial);}\n cf_backup_write(0,boots+1);printf(\"BACKUP BOOTS=%u\\n\",boots+1);\n unsigned flags=cf_reset_flags();cf_reset_flags_clear();\n printf(\"BOOT: %s\\n\",flags&(1u<<29)?\"IWDG RESET\":\"POWER / MCU RESET\");\n cf_gpio_mode(PA5,CF_OUTPUT);cf_gpio_write(PA5,0);\n cf_exti_begin(PC13,1,1);\n const unsigned channels[2]={PA0,PB0};\n if(cf_adc_dma_begin(channels,2,samples,2,1,1))puts(\"DMA CONFIG ERROR\");\n cf_crc_begin();cf_crc_word(0x12345678);printf(\"CRC=%u\\n\",cf_crc_value());\n puts(\"A=ADC, B=button, R=watchdog, T=RTC, F=RTC test at 1024 Hz. B1 toggles LED.\");\n cf_iwdg_begin(0,31);unsigned feeding=1,last=0;\n for(;;){if(feeding)cf_iwdg_refresh();int c=cf_uart_read();\n  if(c=='A')printf(\"ADC DMA: %u / %u\\n\",samples[0],samples[1]);\n  if(c=='B')printf(\"EXTI B1: %u\\n\",button_count);\n  if(c=='T'){unsigned t[7],bank=0;cf_rtc_calendar(t);cf_backup_read(0,&bank);printf(\"RTC %u-%u-%u %u:%u:%u BACKUP=%u\\n\",t[0],t[1],t[2],t[4],t[5],t[6],bank);}\n  if(c=='F'){\n   R(0x40002824)=0xca;R(0x40002824)=0x53;R(0x4000280c)|=128;\n   while(!(R(0x4000280c)&64)){}\n   R(0x40002810)=31;R(0x40002810)=31;R(0x4000280c)&=~128u;\n   R(0x40002824)=0xff;puts(\"RTC TEST: 1024 calendar ticks / simulated second\");\n  }\n  if(c=='R'){feeding=0;puts(\"WATCHDOG REFRESH STOPPED\");}\n  if(last!=button_count){last=button_count;printf(\"B1 IRQ=%u LED=%u\\n\",last,last&1);}\n  cf_delay_us(200);\n }\n}\n",
